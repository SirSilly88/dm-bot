# Copy to .env and fill in. Never commit or share .env.

# Any random string you make up. Paste the same value into Meta's webhook "Verify token" box.
VERIFY_TOKEN=pick-a-long-random-string

# Meta app dashboard → App settings → Basic → App secret
APP_SECRET=

# One Page access token per Facebook Page, separated by commas (see README step 4).
# Each Page's linked Instagram account is picked up automatically.
PAGE_ACCESS_TOKENS=

# For `npm test` / DRY_RUN only: fake accounts instead of real tokens
# DRY_RUN_ACCOUNTS=[{"pageId":"P1","pageName":"My Page","igId":"IG1","igUsername":"me"}]

PORT=3000
GRAPH_VERSION=v23.0

# 1 = log what would be sent instead of calling Meta (for local testing)
DRY_RUN=
